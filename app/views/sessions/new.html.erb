<h2>管理者ログイン</h2>
<p>記事の作成・編集・削除には管理者ログインが必要です。</p>

<%= form_with url: login_path, class: "admin-form login-form" do |form| %>
  <div>
    <%= form.label :username, "ユーザー名" %>
    <%= form.text_field :username, required: true, autocomplete: "username" %>
  </div>
  <div>
    <%= form.label :password, "パスワード" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password" %>
  </div>
  <div class="form-actions">
    <%= form.submit "ログイン", class: "btn-primary" %>
    <%= link_to "トップへ戻る", root_path, class: "btn-secondary" %>
  </div>
<% end %>
