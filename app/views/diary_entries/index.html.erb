<h2>日記の管理</h2>
<div class="admin-panel">
  <div class="admin-actions">
    <%= link_to "新規日記を追加", new_diary_entry_path, class: "btn-primary" %>
    <%= link_to "日記ページを見る", diary_path, class: "btn-secondary" %>
  </div>

  <% if @diary_entries.any? %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>日付</th>
          <th>本文（抜粋）</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @diary_entries.each do |entry| %>
          <tr>
            <td><%= format_diary_date(entry.entry_date) %></td>
            <td><%= truncate(entry.body, length: 60) %></td>
            <td class="row-actions">
              <%= link_to "編集", edit_diary_entry_path(entry), class: "btn-secondary" %>
              <%= button_to "削除", diary_entry_path(entry), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "この日記を削除しますか？" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>日記はまだありません。</p>
  <% end %>
</div>
