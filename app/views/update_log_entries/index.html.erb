<h2>追加ログの管理</h2>
<div class="admin-panel">
  <div class="admin-actions">
    <%= link_to "新規ログを追加", new_update_log_entry_path, class: "btn-primary" %>
    <%= link_to "追加ログページを見る", update_content_path, class: "btn-secondary" %>
  </div>

  <% if @update_log_entries.any? %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>日付</th>
          <th>タイトル</th>
          <th>操作</th>
        </tr>
      </thead>
      <tbody>
        <% @update_log_entries.each do |entry| %>
          <tr>
            <td><%= format_update_log_date(entry.log_date) %></td>
            <td><%= entry.title.presence || truncate(strip_tags(entry.body), length: 40) %></td>
            <td class="row-actions">
              <%= link_to "編集", edit_update_log_entry_path(entry), class: "btn-secondary" %>
              <%= button_to "削除", update_log_entry_path(entry), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: "このログを削除しますか？" } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>追加ログはまだありません。</p>
  <% end %>
</div>
