<section class="link-collection">
  <h2>リンク</h2>
  <div class="link-cards">
    <a href="https://github.com/shibazaki2028-jp" target="_blank" rel="noopener noreferrer" class="link-card">
      <div class="icon" style="background-color: #333;">GH</div>
      <h3>作者のgithub</h3>
      <p>githubのリンクです</p>
    </a>
  </div>
</section>

<section class="articles-section">
  <h2>記事</h2>
  <% if @articles.any? %>
    <ul class="article-list">
      <% @articles.each do |article| %>
        <li class="article-card">
          <h3><%= article.title %></h3>
          <p class="article-meta"><%= l(article.created_at, format: :long) %></p>
          <div class="article-body"><%= simple_format(article.body) %></div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p>まだ記事はありません。</p>
  <% end %>
</section>
